# Choose one provider: openrouter | gemini  (leave keys empty for offline demo mode)
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Safety limits
MAX_ROWS_TO_LLM=20
MAX_UPLOAD_MB=50
MAX_SESSION_UPLOAD_MB=200
MAX_SESSION_EXPORT_MB=200
MAX_FILES_PER_SESSION=20
MAX_EXPORTS_PER_SESSION=20
SESSION_STORAGE_RETENTION_HOURS=24

# Security
# Comma-separated browser origins allowed to call the API (only needed if the frontend is hosted elsewhere)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Set to false on shared deployments to stop API keys being sent through /api/config/switch
ALLOW_KEY_OVERRIDE=true
